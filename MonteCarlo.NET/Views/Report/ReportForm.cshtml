@model ReportFormViewModel

<div class="container">
    <div class="row justify-content-center align-items-center">

        <div class="col-12 col-md-6">
            <h1>Wyślij zgłoszenie</h1>
            <form asp-controller="Report" asp-action="SubmitReport" method="post">
                <div class="form-group">
                    <label for="Title">Tytuł</label>
                    <input type="text" asp-for="Title" class="form-control" placeholder="Wpisz tytuł" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="Content">Treść</label>
                    <input type="text" asp-for="Content" class="form-control" placeholder="Wypisz treść" />
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="Notes">Notatka</label>
                    <input type="text" asp-for="Notes" class="form-control" />
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Wyślij zgłoszenie</button>
            </form>
        </div>
    </div>
</div>