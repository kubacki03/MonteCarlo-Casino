@model MatchesAndBetsViewModel

@{
    ViewData["Title"] = "Dostępne mecze i moje zakłady";
}
<style>
    .error-message {
        color: red;
        font-size: 18px;
        margin-top: 20px;
    }
</style>
<h1>Dostępne mecze</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="error-message">
        @TempData["ErrorMessage"]
    </div>
}
<table class="table text-white">
    <thead>
        <tr>
            <th>Gospodarze</th>
            <th>Goście</th>
            <th>Data</th>
            <th>Kurs na gospodarzy</th>
            <th>Kurs na gości</th>
            <th>Obstaw zwycięzcę</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var match in Model.Matches)
        {
            if (match.Date > DateOnly.FromDateTime(DateTime.Now)){
            <tr>
                <td>@match.HomeTeamName</td>
                <td>@match.AwayTeamName</td>
                <td>@match.Date.ToString("yyyy-MM-dd")</td>
                <td>@match.HomeTeamOdds</td>
                <td>@match.AwayTeamOdds</td>
                <td>
                    <form asp-action="SetBet" method="post">
                        <input type="hidden" name="matchId" value="@match.MatchId" />
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="teamId" value="@match.HomeTeamId" id="home-@match.MatchId" required>
                            <label class="form-check-label" for="home-@match.MatchId">Gospodarze</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="teamId" value="@match.AwayTeamId" id="away-@match.MatchId" required>
                            <label class="form-check-label" for="away-@match.MatchId">Goście</label>
                        </div>
                        <div class="form-group">
                            <label for="Bet-@match.MatchId">Kwota</label>
                            <input type="number" class="form-control" name="stake" id="Bet-@match.MatchId" required min="1" />
                        </div>
                        <button type="submit" class="btn btn-primary">Obstaw</button>
                    </form>
                </td>
            </tr>
        }
        }
    </tbody>
</table>

<h2>Moje zakłady</h2>

<table class="table text-white">
    <thead>
        <tr>
            <th>Mecz</th>
            <th>Postawiona kwota</th>
            <th>Wybrany zwycięzca</th>
            <th>Wynik</th>
          
        </tr>
    </thead>
    <tbody>
        @foreach (var bet in Model.Bets)
        {
            var match = Model.Matches.FirstOrDefault(m => m.MatchId == bet.MatchId);
            
            <tr>
                <td>@match?.HomeTeamName vs @match?.AwayTeamName</td>
                <td>@bet.StakedAmount</td>
                <td>@(bet.WinnerTeamId == match?.HomeTeamId ? "Gospodarze" : "Goście")</td>
                <td>@(bet.IsRewardGranted ? (bet.HasWon ? "Wygrana" : "Przegrana") : "W trakcie")</td>
         
            </tr>
        }
    </tbody>
</table>
