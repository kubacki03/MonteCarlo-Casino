@model List<UserBan>

<h1>Historia banów</h1>

<div class="row">
	<form method="get" asp-controller="Administrator" asp-action="Ban">
		<div class="form-group w-50">
			<label for="opcjaSortBan">Wybierz opcje sortowania</label>
			@if (ViewBag.SelectedBanOption != null)
			{
				<div class="alert alert-info">
					@ViewBag.SelectedBanOption
				</div>
			}
			<select name="sortOption" id="opcjaSortBan" class="form-control">
				<option value="" selected disabled>Wybierz opcję sortowania</option>
				@foreach (var option in ViewBag.banSortOptions)
				{
					<option value="@option">@option</option>
				}
			</select>
		</div>
		<label for="searchTextBan">Wyszukaj użytkownika</label>
		<div class="d-flex">
			<div class="formg-group w-50">
				<input type="text" name="searchText" id="searchTextBan" class="form-control" autocomplete="off" />
			</div>

			<button type="submit" class="btn btn-primary ms-5 btnCustom">Filtruj</button>
		</div>
	</form>
</div>

<table class="table text-white">
	<thead>
		<tr>
			<th>Nazwa użytkownika</th>
			<th>Nazwisko</th>
			<th>Imie</th>
			<th>Data początku banu</th>
			<th>Czas banu (dni)</th>
			<th>Przyczyna</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var row in Model)
		{
			<tr>
				<td>@row.UserName</td>
				<td>@row.LastName</td>
				<td>@row.FirstName</td>
				<td>@row.Date.ToString("dd.MM.yyyy")</td>
				<td>@row.DurationDays</td>
				<td>@row.Reason</td>
			</tr>
			
		}
	</tbody>
</table>
