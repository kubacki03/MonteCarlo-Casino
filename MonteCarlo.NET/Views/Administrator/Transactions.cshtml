@model List<UserTransaction>

<h1>Historia transakcji</h1>

<div class="row">
	<form method="get" asp-controller="Administrator" asp-action="Transactions">
		<div class="form-group w-50">
			<label for="opcjaSort">Wybierz opcje sortowania</label>
			@if (ViewBag.SelectedTransactionOption != null)
			{
				<div class="alert alert-info">
					@ViewBag.SelectedTransactionOption
				</div>
			}
			<select name="sortOption" id="opcjaSortTransakcja" class="form-control">
				<option value="" selected disabled>Wybierz opcję sortowania</option>
				@foreach (var option in ViewBag.transactionSortOptions)
				{
					<option value="@option">@option</option>
				}
			</select>
		</div>
		<label for="searchText">Wyszukaj użytkownika</label>
		<div class="d-flex">
			<div class="formg-group w-50">
				<input type="text" name="searchText" id="searchTextTransakcja" class="form-control" autocomplete="off" />
			</div>
			<button type="submit" class="btn btn-primary ms-5 btnCustom">Filtruj</button>
		</div>
	</form>
</div>

<table class="table text-white">
<thead>
	<tr>
		<th>Nazwa użytkownika</th>
		<th>Nazwisko</th>
		<th>Imie</th>
		<th>Data transakcji</th>
		<th>Kwota</th>
		<th>Typ transakcji</th>
	</tr>
</thead>
<tbody>
	@foreach (var transaction in Model)
	{
		<tr>
			<td>@transaction.UserName</td>
			<td>@transaction.LastName</td>
			<td>@transaction.FirstName</td>
			<td>@transaction.Date.ToString("dd.MM.yyyy")</td>
			<td>@transaction.Amount</td>
			<td>@transaction.Type</td>
		</tr>
	}
</tbody>
</table>
