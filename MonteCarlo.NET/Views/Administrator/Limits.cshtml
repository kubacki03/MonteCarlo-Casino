@model List<UserLimit>

<h1>Limity użytkowników</h1>

<div class="row">
	<form method="get" asp-controller="Administrator" asp-action="Limits">
		<div class="form-group w-50">
			<label for="opcjaSort">Wybierz opcje sortowania</label>
			@if (ViewBag.SelectedLimitOption != null)
			{
				<div class="alert alert-info">
					@ViewBag.SelectedLimitOption
				</div>
			}
			<select name="sortOption" id="opcjaSortLimit" class="form-control">
				<option value="" selected disabled>Wybierz opcję sortowania</option>
				@foreach (var option in ViewBag.limitSortOptions)
				{
					<option value="@option">@option</option>
				}
			</select>
		</div>
		<label for="searchText">Wyszukaj użytkownika</label>
		<div class="d-flex">
			<div class="formg-group w-50">
				<input type="text" name="searchText" id="searchTextLimit" class="form-control" autocomplete="off" />
			</div>
			<button type="submit" class="btn btn-primary ms-5 btnCustom">Filtruj</button>
		</div>
	</form>
</div>

<table class="table text-white">
	<thead>
		<tr>
			<th>Nazwa użytkownika</th>
			<th>Nazwisko</th>
			<th>Imie</th>
			<th>Data</th>
			<th>Kwota</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var row in Model)
		{
			<tr>
				<td>@row.UserName</td>
				<td>@row.LastName</td>
				<td>@row.FirstName</td>
				<td>@row.Date</td>
				<td>@row.Amount</td>
			</tr>
		}
	</tbody>
</table>