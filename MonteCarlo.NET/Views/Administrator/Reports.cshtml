@model List<UserReport>

<h1>Historia zgłoszeń</h1>

<div class="row">
	<form method="get" asp-controller="Administrator" asp-action="Reports">
		<div class="form-group w-50">
			<label for="opcjaSort">Wybierz opcje sortowania</label>
			@if (ViewBag.SelectedReportOption != null)
			{
				<div class="alert alert-info">
					@ViewBag.SelectedReportOption
				</div>
			}
			<select name="sortOption" id="opcjaSortZgloszenie" class="form-control">
				<option value="" selected disabled>Wybierz opcję sortowania</option>
				@foreach (var option in ViewBag.reportSortOptions)
				{
					<option value="@option">@option</option>
				}
			</select>
		</div>
		<label for="searchText">Wyszukaj użytkownika</label>
		<div class="d-flex">
			<div class="formg-group w-50">
				<input type="text" name="searchText" id="searchTextZgloszenie" class="form-control" autocomplete="off" />
			</div>
			<button type="submit" class="btn btn-primary ms-5 btnCustom">Filtruj</button>
		</div>
	</form>
</div>

<table class="table text-white">
	<thead>
		<tr>
			<th>Nazwa użytkownika</th>
			<th>Nazwisko</th>
			<th>Imie</th>
			<th>Data zgłoszenia</th>
			<th>Status</th>
			<th>Tytuł</th>
			<th>Szczegóły</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var report in Model)
		{
			<tr>
				<td>@report.UserName</td>
				<td>@report.LastName</td>
				<td>@report.FirstName</td>
				<td>@report.Date.ToString("dd.MM.yyyy")</td>
				<td>@report.Status</td>
				<td>@report.Title</td>
				<td>
					<form asp-controller="Administrator" asp-action="ReportDetails" method="post">
						<input type="hidden" id="poleZgloszenieId" name="reportId" value="@report.ReportId" />
						<button type="submit" class="btn btn-info">Szczegóły</button>
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>