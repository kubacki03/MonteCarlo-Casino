@model List<UserAccount>
<h1>Dane Użytkowników</h1>

<div class="row">
	<form method="get" asp-controller="Administrator" asp-action="Users">
		<div class="form-group w-50">
			<label for="opcjaSort">Wybierz opcje sortowania</label>
			@if (ViewBag.SelectedOption != null)
			{
				<div class="alert alert-info">
					@ViewBag.SelectedOption
				</div>
			}
			<select name="sortOption" id="opcjaSort" class="form-control">
				<option value="" selected disabled>Wybierz opcję sortowania</option>
				@foreach (var option in ViewBag.userSortOptions)
				{
					<option value="@option">@option</option>
				}
			</select>
		</div>
		<label for="searchText">Wyszukaj użytkownika</label>
		<div class="d-flex">
			<div class="formg-group w-50">
				<input type="text" name="searchText" id="searchText" class="form-control" autocomplete="off" />
			</div>
		
			<button type="submit" class="btn btn-primary ms-5 btnCustom">Filtruj</button>
		</div>
	</form>
</div>


<table class="table text-white">
	<thead>
		<tr>
			<th>Nazwa użytkownika</th>
			<th>Nazwisko</th>
			<th>Imie</th>
			<th>Saldo</th>
			<th>Level</th>
			<th>Data końca bana</th>
			<th>Akcja</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var user in Model)
		{
			<tr>
				<td>@user.UserName</td>
				<td>@user.LastName</td>
				<td>@user.FirstName</td>
				<td>@user.Balance</td>
				<td>@user.Level</td>
				<td>@user.LockoutEnd?.ToString("dd.MM.yyyy HH:mm:ss")</td>
				<td>
					<form asp-controller="Administrator" asp-action="SelectUserForBan" method="post">
						<input type="hidden" id="poleUzytkownikId" name="userId" value="@user.Id" />

						@if (user.LockoutEnabled)
						{
							<button type="submit" class="btn btn-danger">Zbanuj</button>
						}
						else
						{
							<button type="submit" class="btn btn-success">Odbanuj</button>
						}
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>