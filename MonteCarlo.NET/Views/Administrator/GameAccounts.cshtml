@model List<UserGameAccount>

<h1>Historia rozgrywek</h1>

<div class="row">
	<form method="get" asp-controller="Administrator" asp-action="GameAccounts">
		<div class="form-group w-50">
			<label for="opcjaSort">Wybierz opcje sortowania</label>
			@if (ViewBag.SelectedGameAccountOption != null)
			{
				<div class="alert alert-info">
					@ViewBag.SelectedGameAccountOption
				</div>
			}
			<select name="sortOption" id="opcjaSortGraKonto" class="form-control">
				<option value="" selected disabled>Wybierz opcję sortowania</option>
				@foreach (var option in ViewBag.gameAccountSortOptions)
				{
					<option value="@option">@option</option>
				}
			</select>
		</div>
		<label for="searchText">Wyszukaj użytkownika</label>
		<div class="d-flex">
			<div class="formg-group w-50">
				<input type="text" name="searchText" id="searchTextGraKonto" class="form-control" autocomplete="off" />
			</div>
			<button type="submit" class="btn btn-primary ms-5 btnCustom">Filtruj</button>
		</div>
	</form>
</div>

<table class="table text-white">
	<thead>
		<tr>
			<th>Nazwa użytkownika</th>
			<th>Nazwisko</th>
			<th>Imie</th>
			<th>Nazwa gry</th>
			<th>Ile użytkownik postawił</th>
			<th>Ile użytkownik wygrał</th>
			<th>Data i godzina rozgrywki</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var row in Model)
		{
			<tr>
				<td>@row.UserName</td>
				<td>@row.LastName</td>
				<td>@row.FirstName</td>
				<td>@row.GameName</td>
				<td>@row.AmountStaked</td>
				<td>@row.AmountWon</td>
				<td>@row.PlayedAt</td>
			</tr>
		}
	</tbody>
</table>